#!/bin/sh

python3 tools/check_request_links.py

if [ $? -ne 0 ]; then
    echo "Request links are invalid."
    exit 1
fi

gdformat --diff .

if [ $? -ne 0 ]; then
    echo "gdformat reported errors. Please run gdformat."
    exit 1
fi

gdlint .

if [ $? -ne 0 ]; then
    echo "gdlint reported errors. Please fix it."
fi
